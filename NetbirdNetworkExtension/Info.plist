<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.networkextension.packet-tunnel</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).PacketTunnelProvider</string>
	</dict>
	<!-- JetBox: management по умолчанию — из Config/JetBoxEdition.xcconfig. -->
	<key>JetBoxManagementURL</key>
	<string>https://$(JETBOX_MANAGEMENT_HOST)</string>
	<!-- JetBox: шифрование только стандартное, освобождённое от документов экспорта
	     (ответ Apple: Yes, standard only; решение руководителя 22.11.2026). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
