    "jetbox.privacy.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JetBox sends only the technical details needed to connect: device name, app version, and network addresses, so your home network can recognize this device. We don’t collect or store your traffic, and we don’t share data with third parties."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение передаёт на сервер JetNet только служебные данные подключения: имя устройства, версию приложения и сетевые адреса — они нужны, чтобы ваша сеть узнала это устройство. Содержимое трафика не собирается и не хранится. Данные не передаются третьим лицам."
          }
        }
      }
    },
