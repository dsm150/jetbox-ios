    "jetbox.consent.device.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device name and model, app and iOS version, so your JetBox can recognize this iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя и модель устройства, версии приложения и iOS — чтобы ваш JetBox узнал этот iPhone."
          }
        }
      }
    },
    "jetbox.consent.device.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device details"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сведения об устройстве"
          }
        }
      }
    },
    "jetbox.consent.email.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To send your login link and recognize your account."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы прислать ссылку для входа и узнать ваш аккаунт."
          }
        }
      }
    },
    "jetbox.consent.email.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email address"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Email"
          }
        }
      }
    },
    "jetbox.consent.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you log in and connect, here’s what the app sends to JetBox and why."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем вы войдёте и подключитесь — что приложение передаёт JetBox и зачем."
          }
        }
      }
    },
    "jetbox.consent.network.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To set up the encrypted connection between this iPhone and your JetBox. Your traffic goes directly between them; our server only helps them find each other."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы установить зашифрованное соединение между этим iPhone и вашим JetBox. Трафик идёт напрямую между ними; наш сервер только помогает им найти друг друга."
          }
        }
      }
    },
    "jetbox.consent.network.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network addresses and connection key"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сетевые адреса и ключ подключения"
          }
        }
      }
    },
    "jetbox.consent.never": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We never collect the content of your traffic or your browsing history. No ads, no analytics, no tracking, and we don’t sell your data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое трафика и историю браузера мы не собираем никогда. Без рекламы, аналитики и слежки, данные не продаём."
          }
        }
      }
    },
    "jetbox.consent.read_policy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the Privacy Policy"
          }
        },
        "ru": {
