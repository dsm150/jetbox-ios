    "jetbox.consent.accept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agree and continue"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принять и продолжить"
          }
        }
      }
