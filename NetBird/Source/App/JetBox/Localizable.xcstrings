      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JetBox sends only technical connection data to the JetBox server: device name, app version and network addresses — your home network needs them to recognise this device. The content of your traffic is not collected or stored. Data is not shared with third parties."
