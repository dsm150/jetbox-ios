    "jetbox.about.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JetBox is the companion app for your JetBox. Based on the open-source NetBird client (GPL-3.0)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "JetBox — приложение для вашего JetBox. Основано на открытом клиенте NetBird (лицензия GPL-3.0)."
          }
        }
      }
    },
    "jetbox.about.legal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "© %@ JetNet. Based on the NetBird client © NetBird. Distributed under the GNU GPL v3 without any warranty."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "© %@ JetNet. Основано на клиенте NetBird © NetBird. Распространяется по лицензии GNU GPL v3 без каких-либо гарантий."
          }
        }
      }
    },
