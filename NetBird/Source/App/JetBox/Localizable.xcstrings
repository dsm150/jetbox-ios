    "jetbox.error.broken.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link can’t be used to connect. Ask JetBox support for a new one."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта ссылка не подходит для подключения. Запросите новую ссылку у поддержки JetBox."
          }
        }
      }
    },
    "jetbox.error.broken.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link doesn’t work"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка повреждена"
          }
        }
      }
    },
