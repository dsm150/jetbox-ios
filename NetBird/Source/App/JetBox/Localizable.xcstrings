    "jetbox.error.broken.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link cannot be used to connect. Ask JetBox support for a new one."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта ссылка не подходит для подключения. Запросите новую ссылку у поддержки JetBox."
          }
        }
      }
    },
    "jetbox.error.broken.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link is damaged"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка повреждена"
          }
        }
      }
    },
    "jetbox.error.details": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Details"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подробности"
          }
        }
      }
    },
    "jetbox.error.generic.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again. If it keeps happening, show the details to JetBox support."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте ещё раз. Если повторяется — покажите подробности поддержке JetBox."
          }
        }
      }
    },
    "jetbox.error.generic.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так"
          }
        }
      }
    },
    "jetbox.error.key.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key in the link was rejected: it may already be used or expired. Ask for a new connection link."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ из ссылки отклонён: он мог быть уже использован или просрочен. Запросите новую ссылку подключения."
          }
        }
      }
    },
    "jetbox.error.key.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link is no longer valid"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка больше не действует"
          }
        }
      }
    },
    "jetbox.error.offline.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to Wi-Fi or mobile data and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к Wi-Fi или мобильной сети и попробуйте снова."
          }
        }
      }
    },
    "jetbox.error.offline.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет интернета"
          }
        }
      }
    },
    "jetbox.error.tunnel.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow JetBox to set up a VPN — protection cannot start without it. If you already allowed it, try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите JetBox настроить VPN — без этого защита не включится. Если разрешение уже дано, попробуйте ещё раз."
          }
        }
      }
    },
    "jetbox.error.tunnel.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not turn protection on"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось включить защиту"
          }
        }
      }
    },
    "jetbox.error.unreachable.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot reach the JetBox server. Check your internet; if that doesn’t help, contact support."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удаётся связаться с сервером JetBox. Проверьте интернет; если не помогло — свяжитесь с поддержкой."
          }
        }
      }
    },
    "jetbox.error.unreachable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JetBox is not responding"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "JetBox не отвечает"
          }
        }
