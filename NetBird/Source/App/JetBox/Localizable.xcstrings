    "jetbox.error.foreign.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link points to a server that is not JetBox. We did not connect and left your current connection as it was. Use only links from your JetBox account or support."
          }
        }
      }
    },
    "jetbox.error.foreign.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a JetBox server"
          }
        }
      }
    },
    "jetbox.error.generic.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again. If it keeps happening, show the details to JetBox support."
          }
        }
      }
    },
    "jetbox.error.generic.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        }
      }
