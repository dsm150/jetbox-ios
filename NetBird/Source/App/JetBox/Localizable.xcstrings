          "stringUnit": {
            "state": "translated",
            "value": "Details"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подробности"
          }
        }
      }
    },
    "jetbox.error.device_limit.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your JetBox already has the maximum number of devices. Contact support to free up a place."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К вашему JetBox уже подключено максимальное число устройств. Свяжитесь с поддержкой, чтобы освободить место."
          }
        }
      }
    },
    "jetbox.error.device_limit.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many devices"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много устройств"
          }
        }
      }
    },
    "jetbox.error.foreign.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link leads to a server that isn’t part of JetBox, so we didn’t connect. Your current connection wasn’t changed. Only use links from your JetBox account or JetBox support."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта ссылка ведёт на сервер, который не относится к JetBox. Мы не подключались, текущее подключение не тронуто. Используйте только ссылки из Личного кабинета JetBox или от поддержки."
          }
        }
      }
    },
    "jetbox.error.unsigned.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link isn’t from JetBox"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта ссылка не от JetBox"
          }
        }
      }
    },
    "jetbox.error.unsigned.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We didn’t connect, and your current connection wasn’t changed. Only use links from your JetBox account or JetBox support."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы не подключались, текущее подключение не тронуто. Используйте только ссылки из Личного кабинета JetBox или от поддержки."
          }
        }
      }
    },
    "jetbox.error.foreign.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a JetBox link"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка не от JetBox"
          }
        }
      }
    },
    "jetbox.error.generic.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please try again. If it keeps happening, send the details to JetBox support."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте ещё раз. Если повторяется — покажите подробности поддержке JetBox."
          }
        }
      }
    },
    "jetbox.error.generic.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так"
          }
        }
      }
    },
    "jetbox.error.key.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key in this link has already been used or has expired. Request a new connection link."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ из ссылки отклонён: он мог быть уже использован или просрочен. Запросите новую ссылку подключения."
          }
        }
      }
    },
    "jetbox.error.key.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link has expired"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка больше не действует"
          }
        }
      }
    },
    "jetbox.error.login_expired.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request a new link"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросить новую ссылку"
          }
        }
      }
    },
    "jetbox.error.login_expired.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A login link works once, for 15 minutes. Request a new one."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка для входа работает один раз в течение 15 минут. Запросите новую."
          }
        }
      }
    },
    "jetbox.error.login_expired.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link expired or already used"
          }
        },
        "ru": {
