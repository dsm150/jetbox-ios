+package internal
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/netbirdio/netbird/client/internal/peer"
+	mgmProto "github.com/netbirdio/netbird/shared/management/proto"
+	relayClient "github.com/netbirdio/netbird/shared/relay/client"
+)
+
+// With NB_DISABLE_RELAY the agent must ignore relay and TURN servers sent by
+// management: no relay URLs in the manager, no TURN URIs for ICE.
+func TestEngine_RelayDisabled_IgnoresManagementRelayAndTURN(t *testing.T) {
+	t.Setenv(peer.EnvKeyNBDisableRelay, "true")
+	t.Setenv(peer.EnvKeyNBHomeRelayServers, "rels://override.example:443")
+	t.Setenv(peer.EnvKeyNBForceRelay, "true")
+
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	e := &Engine{relayManager: relayClient.NewManager(ctx, nil, "peer-key", 1280)}
+
+	err := e.handleRelayUpdate(&mgmProto.RelayConfig{
+		Urls:           []string{"rels://relay.example:443"},
+		TokenPayload:   "payload",
+		TokenSignature: "signature",
+	})
+	require.NoError(t, err)
+	assert.False(t, e.relayManager.HasRelayAddress(), "relay manager must have no server URLs")
+	assert.Empty(t, e.relayManager.ServerURLs(), "relay URLs from management must be dropped")
+	_, _, err = e.relayManager.RelayInstanceAddress()
+	assert.Error(t, err, "no relay connection may be open")
+
+	err = e.updateTURNs([]*mgmProto.ProtectedHostConfig{{
+		HostConfig: &mgmProto.HostConfig{Uri: "turn:turn.example:3478", Protocol: mgmProto.HostConfig_UDP},
+		User:       "user",
+		Password:   "password",
+	}})
+	require.NoError(t, err)
+	assert.Empty(t, e.TURNs, "TURN servers from management must be dropped")
+
+	assert.False(t, peer.IsForceRelayed(), "NB_DISABLE_RELAY wins over NB_FORCE_RELAY")
+}
+
+func TestEngine_RelayEnabled_KeepsManagementTURN(t *testing.T) {
+	t.Setenv(peer.EnvKeyNBDisableRelay, "")
+
+	e := &Engine{}
+	err := e.updateTURNs([]*mgmProto.ProtectedHostConfig{{
+		HostConfig: &mgmProto.HostConfig{Uri: "turn:turn.example:3478", Protocol: mgmProto.HostConfig_UDP},
+	}})
+	require.NoError(t, err)
+	assert.Len(t, e.TURNs, 1, "upstream default keeps TURN servers")
+}
