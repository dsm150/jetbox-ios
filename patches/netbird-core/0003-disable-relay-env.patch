+// IsRelayDisabled reports whether NB_DISABLE_RELAY is set to true. When it is, the
+// agent opens no connection to relay or TURN servers and gathers no relay candidates.
+func IsRelayDisabled() bool {
+	val := os.Getenv(EnvDisableRelay)
+	if val == "" {
+		return false
+	}
+	disabled, err := strconv.ParseBool(val)
+	if err != nil {
+		log.Warnf("failed to parse %s: %v", EnvDisableRelay, err)
+		return false
+	}
+	return disabled
+}
