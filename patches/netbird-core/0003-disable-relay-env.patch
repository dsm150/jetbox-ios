+package ice
+
+import (
+	"testing"
+
+	"github.com/pion/ice/v4"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestCandidateTypes_RelayDisabled(t *testing.T) {
+	t.Setenv(EnvDisableRelay, "true")
+	// NB_ICE_FORCE_RELAY_CONN would otherwise leave only relay candidates.
+	t.Setenv(envICEForceRelayConn, "true")
+
+	got := CandidateTypes()
+	assert.NotContains(t, got, ice.CandidateTypeRelay, "relay candidates must not be gathered")
+	assert.ElementsMatch(t, CandidateTypesP2P(), got, "only host and server reflexive candidates")
+}
+
+func TestCandidateTypes_RelayEnabledByDefault(t *testing.T) {
+	t.Setenv(EnvDisableRelay, "")
+
+	assert.Contains(t, CandidateTypes(), ice.CandidateTypeRelay, "upstream default keeps relay candidates")
+}
+
+func TestIsRelayDisabled(t *testing.T) {
+	cases := map[string]bool{"": false, "true": true, "1": true, "false": false, "junk": false}
+	for val, want := range cases {
+		t.Setenv(EnvDisableRelay, val)
+		assert.Equal(t, want, IsRelayDisabled(), "value %q", val)
+	}
+}
