+++ b/client/internal/debug/upload_default_test.go
@@ -0,0 +1,19 @@
+package debug
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/netbirdio/netbird/upload-server/types"
+)
+
+func TestUploadDebugBundle_NoDefaultService(t *testing.T) {
+	assert.Empty(t, types.DefaultBundleURL, "there must be no built-in upload service")
+
+	_, err := UploadDebugBundle(context.Background(), types.DefaultBundleURL, "https://mgm.example", "/nonexistent", false)
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "not configured", "upload without a URL is refused before any request")
+}
