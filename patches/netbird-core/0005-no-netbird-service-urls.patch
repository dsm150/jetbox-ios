@@ -0,0 +1,17 @@
+package metrics
+
+import (
+	"os"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestMetrics_NoDefaultServer(t *testing.T) {
+	t.Setenv(EnvMetricsConfigURL, "")
+	require.NoError(t, os.Unsetenv(EnvMetricsConfigURL))
+
+	assert.Empty(t, getMetricsConfigURL(), "no built-in metrics config server")
+	assert.Nil(t, defaultMetricsServerURL, "no built-in metrics ingest server")
+}
