+package internal
+
+import (
+	"context"
+	"fmt"
+	"net/netip"
+	"os"
+	"sort"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"golang.zx2c4.com/wireguard/wgctrl/wgtypes"
+
+	"github.com/netbirdio/netbird/client/iface"
+	"github.com/netbirdio/netbird/client/iface/wgaddr"
+	"github.com/netbirdio/netbird/client/internal/dns"
+	"github.com/netbirdio/netbird/client/internal/peer"
+	"github.com/netbirdio/netbird/client/internal/routemanager"
+	"github.com/netbirdio/netbird/client/internal/stdnet"
+	"github.com/netbirdio/netbird/route"
+	mgmt "github.com/netbirdio/netbird/shared/management/client"
+	mgmtProto "github.com/netbirdio/netbird/shared/management/proto"
+	relayClient "github.com/netbirdio/netbird/shared/relay/client"
+	signal "github.com/netbirdio/netbird/shared/signal/client"
+)
+
+// A network map as management sends it to a JetBox phone: the own box exit
+// (v4 + v6 pair), the own box LAN, and a foreign exit that must never apply.
+func exitTestNetworkMap() *mgmtProto.NetworkMap {
+	r := func(id, network, netID string) *mgmtProto.Route {
+		return &mgmtProto.Route{ID: id, Network: network, NetID: netID, Peer: "box-peer", NetworkType: 1, Masquerade: true}
+	}
+	return &mgmtProto.NetworkMap{
+		Serial: 7,
+		Routes: []*mgmtProto.Route{
+			r("own4", "0.0.0.0/0", "sv-demo-us-exit"),
+			r("own6", "::/0", "sv-demo-us-exit-v6"),
+			r("lan", "192.168.60.0/24", "sv-demo-us-lan"),
+			r("foreign4", "0.0.0.0/0", "cl-exit"),
+			r("foreign6", "::/0", "cl-exit-v6"),
+			r("other4", "0.0.0.0/0", "sv-other-exit"),
+		},
+	}
+}
+
+// netIDsPassedToManager runs updateNetworkMap on a real engine with a mock route
+// manager and returns the NetIDs the route manager received for the tunnel.
+func netIDsPassedToManager(t *testing.T, n int, nm *mgmtProto.NetworkMap) []string {
+	t.Helper()
+	key, err := wgtypes.GeneratePrivateKey()
+	require.NoError(t, err)
+
+	ctx, cancel := context.WithCancel(CtxInitState(context.Background()))
+	t.Cleanup(cancel)
+
+	wgIfaceName := fmt.Sprintf("utun%d", 140+n)
+	wgAddr := fmt.Sprintf("100.67.%d.1/24", n)
+	engine := NewEngine(ctx, cancel, &EngineConfig{
+		WgIfaceName:  wgIfaceName,
+		WgAddr:       wgaddr.MustParseWGAddress(wgAddr),
+		WgPrivateKey: key,
+		WgPort:       33200,
+		MTU:          iface.DefaultMTU,
+	}, EngineServices{
+		SignalClient:   &signal.MockClient{},
+		MgmClient:      &mgmt.MockClient{},
+		RelayManager:   relayClient.NewManager(ctx, nil, key.PublicKey().String(), iface.DefaultMTU),
+		StatusRecorder: peer.NewRecorder("https://mgm"),
+	}, MobileDependency{})
+	engine.ctx = ctx
+	newNet, err := stdnet.NewNet(context.Background(), nil)
+	require.NoError(t, err)
+	engine.wgInterface, err = iface.NewWGIFace(iface.WGIFaceOpts{
+		IFaceName:    wgIfaceName,
+		Address:      wgaddr.MustParseWGAddress(wgAddr),
+		WGPort:       engine.config.WgPort,
+		WGPrivKey:    key.String(),
+		MTU:          iface.DefaultMTU,
+		TransportNet: newNet,
+	})
+	require.NoError(t, err)
+
+	var got []string
+	engine.routeManager = &routemanager.MockManager{
+		ClassifyRoutesFunc: func(newRoutes []*route.Route) (map[route.ID]*route.Route, route.HAMap) {
+			clientRoutes := make(route.HAMap)
+			for _, r := range newRoutes {
+				clientRoutes[r.GetHAUniqueID()] = append(clientRoutes[r.GetHAUniqueID()], r)
+			}
+			return nil, clientRoutes
+		},
+		UpdateRoutesFunc: func(_ uint64, _ map[route.ID]*route.Route, clientRoutes route.HAMap, _ bool) error {
+			for _, rs := range clientRoutes {
+				for _, r := range rs {
+					got = append(got, string(r.NetID))
+				}
+			}
+			return nil
+		},
+	}
+	engine.dnsServer = &dns.MockServer{}
+	engine.connMgr = NewConnMgr(engine.config, engine.statusRecorder, engine.peerStore, engine.wgInterface)
+	engine.connMgr.Start(ctx)
+	t.Cleanup(func() { _ = engine.Stop() })
+
+	require.NoError(t, engine.updateNetworkMap(nm))
+	sort.Strings(got)
+	return got
+}
+
+func TestEngine_AllowedExit_OnlyOwnExitReachesTunnel(t *testing.T) {
+	t.Setenv(EnvAllowedExit, "sv-demo-us-exit")
+
+	got := netIDsPassedToManager(t, 0, exitTestNetworkMap())
+	assert.Equal(t, []string{"sv-demo-us-exit", "sv-demo-us-exit-v6", "sv-demo-us-lan"}, got,
+		"own exit, its v6 pair and the box LAN pass in the same update; foreign exits are dropped")
+}
+
+func TestEngine_AllowedExit_EmptyMeansNoDefaultRoute(t *testing.T) {
+	t.Setenv(EnvAllowedExit, "")
+
+	got := netIDsPassedToManager(t, 1, exitTestNetworkMap())
+	assert.Equal(t, []string{"sv-demo-us-lan"}, got, "no pinned exit: no default route at all, LAN stays")
+}
+
+func TestEngine_AllowedExit_UnsetKeepsUpstreamBehavior(t *testing.T) {
+	t.Setenv(EnvAllowedExit, "")
+	require.NoError(t, os.Unsetenv(EnvAllowedExit))
+
+	got := netIDsPassedToManager(t, 2, exitTestNetworkMap())
+	assert.Len(t, got, 6, "without the variable every route reaches the route manager")
+}
+
+func TestFilterExitRoutes(t *testing.T) {
+	mk := func(netID, network string) *route.Route {
+		return &route.Route{NetID: route.NetID(netID), Network: netip.MustParsePrefix(network)}
+	}
+	routes := []*route.Route{
+		mk("own", "0.0.0.0/0"), mk("own-v6", "::/0"), mk("own-lan", "10.0.0.0/24"),
+		mk("evil", "0.0.0.0/0"), mk("evil-v6", "::/0"), mk("own-v6x", "::/0"),
+		{NetID: "dyn", Domains: nil, Network: netip.MustParsePrefix("1.2.3.4/32")},
+	}
+
+	names := func(rs []*route.Route) []string {
+		var out []string
+		for _, r := range rs {
+			out = append(out, string(r.NetID))
+		}
+		return out
+	}
+	assert.Equal(t, []string{"own", "own-v6", "own-lan", "dyn"}, names(filterExitRoutes(routes, "own")),
+		"only the pinned exit and its exact -v6 pair survive")
+	assert.Equal(t, []string{"own-lan", "dyn"}, names(filterExitRoutes(routes, "")),
+		"empty pin drops every default route")
+}
