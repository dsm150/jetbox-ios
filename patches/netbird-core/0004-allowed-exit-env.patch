+func TestEngine_AllowedExit_OnlyOwnExitReachesTunnel(t *testing.T) {
+	t.Setenv(EnvAllowedExit, "sv-demo-us-exit")
+
+	got := netIDsPassedToManager(t, 0, exitTestNetworkMap())
+	assert.Equal(t, []string{"sv-demo-us-exit", "sv-demo-us-exit-v6", "sv-demo-us-lan"}, got,
+		"own exit, its v6 pair and the box LAN pass in the same update; foreign exits are dropped")
+}
+
+func TestEngine_AllowedExit_EmptyMeansNoDefaultRoute(t *testing.T) {
+	t.Setenv(EnvAllowedExit, "")
+
+	got := netIDsPassedToManager(t, 1, exitTestNetworkMap())
+	assert.Equal(t, []string{"sv-demo-us-lan"}, got, "no pinned exit: no default route at all, LAN stays")
+}
+
+func TestEngine_AllowedExit_UnsetKeepsUpstreamBehavior(t *testing.T) {
+	t.Setenv(EnvAllowedExit, "")
+	require.NoError(t, os.Unsetenv(EnvAllowedExit))
+
+	got := netIDsPassedToManager(t, 2, exitTestNetworkMap())
+	assert.Len(t, got, 6, "without the variable every route reaches the route manager")
+}
+
+func TestFilterExitRoutes(t *testing.T) {
+	mk := func(netID, network string) *route.Route {
+		return &route.Route{NetID: route.NetID(netID), Network: netip.MustParsePrefix(network)}
+	}
+	routes := []*route.Route{
+		mk("own", "0.0.0.0/0"), mk("own-v6", "::/0"), mk("own-lan", "10.0.0.0/24"),
+		mk("evil", "0.0.0.0/0"), mk("evil-v6", "::/0"), mk("own-v6x", "::/0"),
+		{NetID: "dyn", Domains: nil, Network: netip.MustParsePrefix("1.2.3.4/32")},
+	}
+
+	names := func(rs []*route.Route) []string {
+		var out []string
+		for _, r := range rs {
+			out = append(out, string(r.NetID))
+		}
+		return out
+	}
+	assert.Equal(t, []string{"own", "own-v6", "own-lan", "dyn"}, names(filterExitRoutes(routes, "own")),
+		"only the pinned exit and its exact -v6 pair survive")
+	assert.Equal(t, []string{"own-lan", "dyn"}, names(filterExitRoutes(routes, "")),
+		"empty pin drops every default route")
+}
+
+// The phone's box and a foreign peer in the same network map. The foreign peer
+// advertises a route with the box exit's own name, a public prefix and a
+// domain route; only the box (by overlay address) and its routes may pass.
+func pinnedTestNetworkMap(t *testing.T) (*mgmtProto.NetworkMap, string, string) {
+	t.Helper()
+	boxKey, err := wgtypes.GeneratePrivateKey()
+	require.NoError(t, err)
+	evilKey, err := wgtypes.GeneratePrivateKey()
+	require.NoError(t, err)
+	box, evil := boxKey.PublicKey().String(), evilKey.PublicKey().String()
+
+	r := func(id, network, netID, peer string, domains ...string) *mgmtProto.Route {
+		return &mgmtProto.Route{ID: id, Network: network, NetID: netID, Peer: peer, NetworkType: 1,
+			Masquerade: true, Domains: domains}
+	}
+	nm := &mgmtProto.NetworkMap{
+		Serial: 9,
+		RemotePeers: []*mgmtProto.RemotePeerConfig{
+			{WgPubKey: box, AllowedIps: []string{"100.79.115.162/32"}, Fqdn: "jetbox-demo-ny.netbird.selfhosted"},
+			{WgPubKey: evil, AllowedIps: []string{"100.79.1.2/32"}, Fqdn: "evil.netbird.selfhosted"},
+		},
+		Routes: []*mgmtProto.Route{
+			r("own4", "0.0.0.0/0", "sv-demo-us-exit", box),
+			r("own6", "::/0", "sv-demo-us-exit-v6", box),
+			r("lan", "192.168.60.0/24", "sv-demo-us-lan", box),
+			r("evil-exit", "0.0.0.0/0", "sv-demo-us-exit", evil),
+			r("evil-net", "8.8.8.0/24", "public-dns", evil),
+			r("evil-dom", "", "evil-domains", evil, "example.com"),
+		},
+	}
+	return nm, box, evil
+}
