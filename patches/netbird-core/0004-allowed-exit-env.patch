+func TestAllowedPeerFromEnv(t *testing.T) {
+	t.Setenv(EnvAllowedPeerIP, "100.79.115.162/32")
+	addr, on := allowedPeerFromEnv()
+	assert.True(t, on)
+	assert.Equal(t, netip.MustParseAddr("100.79.115.162"), addr, "a mask from the server is cut off")
+
+	t.Setenv(EnvAllowedPeerIP, "not-an-ip")
+	addr, on = allowedPeerFromEnv()
+	assert.True(t, on, "set but invalid still pins")
+	assert.False(t, addr.IsValid(), "invalid address matches no peer")
+
+	t.Setenv(EnvAllowedPeerIP, "  ")
+	_, on = allowedPeerFromEnv()
+	assert.False(t, on, "empty drops the pin")
+
+	require.NoError(t, os.Unsetenv(EnvAllowedPeerIP))
+	_, on = allowedPeerFromEnv()
+	assert.False(t, on, "unset keeps upstream behavior")
+}
