+// A network map as management sends it to a JetBox phone: the own box exit
+// (v4 + v6 pair), the own box LAN, and a foreign exit that must never apply.
+func exitTestNetworkMap() *mgmtProto.NetworkMap {
+	r := func(id, network, netID string) *mgmtProto.Route {
+		return &mgmtProto.Route{ID: id, Network: network, NetID: netID, Peer: "box-peer", NetworkType: 1, Masquerade: true}
+	}
+	return &mgmtProto.NetworkMap{
+		Serial: 7,
+		Routes: []*mgmtProto.Route{
+			r("own4", "0.0.0.0/0", "sv-demo-us-exit"),
+			r("own6", "::/0", "sv-demo-us-exit-v6"),
+			r("lan", "192.168.60.0/24", "sv-demo-us-lan"),
+			r("foreign4", "0.0.0.0/0", "cl-exit"),
+			r("foreign6", "::/0", "cl-exit-v6"),
+			r("other4", "0.0.0.0/0", "sv-other-exit"),
+		},
+	}
+}
+
+// netIDsPassedToManager runs updateNetworkMap on a real engine with a mock route
+// manager and returns the NetIDs the route manager received for the tunnel.
+func netIDsPassedToManager(t *testing.T, n int, nm *mgmtProto.NetworkMap) []string {
+	t.Helper()
+	got, _ := applyNetworkMap(t, n, nm)
+	return got
+}
+
+// applyNetworkMap returns the route NetIDs handed to the route manager and the
+// WireGuard keys of the peers the engine created connections for.
+func applyNetworkMap(t *testing.T, n int, nm *mgmtProto.NetworkMap) ([]string, []string) {
+	t.Helper()
+	key, err := wgtypes.GeneratePrivateKey()
+	require.NoError(t, err)
+
+	ctx, cancel := context.WithCancel(CtxInitState(context.Background()))
+	t.Cleanup(cancel)
+
+	wgIfaceName := fmt.Sprintf("utun%d", 140+n)
+	wgAddr := fmt.Sprintf("100.67.%d.1/24", n)
+	engine := NewEngine(ctx, cancel, &EngineConfig{
+		WgIfaceName:  wgIfaceName,
+		WgAddr:       wgaddr.MustParseWGAddress(wgAddr),
+		WgPrivateKey: key,
+		WgPort:       33200,
+		MTU:          iface.DefaultMTU,
+	}, EngineServices{
+		SignalClient:   &signal.MockClient{},
+		MgmClient:      &mgmt.MockClient{},
+		RelayManager:   relayClient.NewManager(ctx, nil, key.PublicKey().String(), iface.DefaultMTU),
+		StatusRecorder: peer.NewRecorder("https://mgm"),
+	}, MobileDependency{})
+	engine.ctx = ctx
+	newNet, err := stdnet.NewNet(context.Background(), nil)
+	require.NoError(t, err)
+	engine.wgInterface, err = iface.NewWGIFace(iface.WGIFaceOpts{
+		IFaceName:    wgIfaceName,
+		Address:      wgaddr.MustParseWGAddress(wgAddr),
+		WGPort:       engine.config.WgPort,
+		WGPrivKey:    key.String(),
+		MTU:          iface.DefaultMTU,
+		TransportNet: newNet,
+	})
+	require.NoError(t, err)
+
+	var got []string
+	engine.routeManager = &routemanager.MockManager{
+		ClassifyRoutesFunc: func(newRoutes []*route.Route) (map[route.ID]*route.Route, route.HAMap) {
+			clientRoutes := make(route.HAMap)
+			for _, r := range newRoutes {
+				clientRoutes[r.GetHAUniqueID()] = append(clientRoutes[r.GetHAUniqueID()], r)
+			}
+			return nil, clientRoutes
+		},
+		UpdateRoutesFunc: func(_ uint64, _ map[route.ID]*route.Route, clientRoutes route.HAMap, _ bool) error {
+			for _, rs := range clientRoutes {
+				for _, r := range rs {
+					got = append(got, string(r.NetID))
+				}
+			}
+			return nil
+		},
+	}
+	engine.dnsServer = &dns.MockServer{}
+	udpConn, err := net.ListenUDP("udp4", nil)
+	require.NoError(t, err)
+	engine.udpMux = udpmux.NewUniversalUDPMuxDefault(udpmux.UniversalUDPMuxParams{UDPConn: udpConn, MTU: 1280})
+	engine.srWatcher = guard.NewSRWatcher(nil, nil, nil, icemaker.Config{})
+	engine.connMgr = NewConnMgr(engine.config, engine.statusRecorder, engine.peerStore, engine.wgInterface)
+	engine.connMgr.Start(ctx)
+	t.Cleanup(func() { _ = engine.Stop() })
+
+	require.NoError(t, engine.updateNetworkMap(nm))
+	sort.Strings(got)
+	peers := engine.peerStore.PeersPubKey()
+	sort.Strings(peers)
+	return got, peers
+}
