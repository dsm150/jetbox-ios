+package internal
+
+import (
+	"net/netip"
+	"os"
+	"strings"
+
+	log "github.com/sirupsen/logrus"
+	"google.golang.org/protobuf/proto"
+
+	"github.com/netbirdio/netbird/route"
+	mgmProto "github.com/netbirdio/netbird/shared/management/proto"
+)
+
+// EnvAllowedExit pins the only exit node the agent may route default traffic
+// through. When the variable is set, default routes (0.0.0.0/0 and ::/0) from
+// management are kept only if their NetID is this value or its "-v6" pair;
+// set but empty means no default route at all. Unset keeps upstream behavior.
+const EnvAllowedExit = "NB_ALLOWED_EXIT"
+
+// EnvAllowedPeerIP pins the only remote peer the agent may talk to: the peer
+// whose overlay address is this IP. When the variable is set, the network map
+// keeps only that peer and only routes whose routing peer is that peer; an
+// unparseable value means no remote peers and no routes at all. Unset or empty
+// keeps upstream behavior: an empty value lets the app drop an earlier pin, as
+// a process cannot unset a variable once it has been exported to the agent.
+const EnvAllowedPeerIP = "NB_ALLOWED_PEER_IP"
+
+// allowedExitFromEnv returns the pinned exit NetID and whether pinning is on.
+func allowedExitFromEnv() (route.NetID, bool) {
+	val, ok := os.LookupEnv(EnvAllowedExit)
+	if !ok {
+		return "", false
+	}
+	return route.NetID(strings.TrimSpace(val)), true
+}
+
+func isDefaultRoute(r *route.Route) bool {
+	return len(r.Domains) == 0 && (route.IsV4DefaultRoute(r.Network) || route.IsV6DefaultRoute(r.Network))
+}
+
+func isAllowedExit(netID, allowed route.NetID) bool {
+	if allowed == "" {
+		return false
+	}
+	return netID == allowed || netID == allowed+route.V6ExitSuffix
+}
+
+// filterExitRoutes drops every default route whose NetID is not the pinned
+// exit, before the routes reach the route manager. Other routes pass as is.
+func filterExitRoutes(routes []*route.Route, allowed route.NetID) []*route.Route {
+	kept := make([]*route.Route, 0, len(routes))
+	for _, r := range routes {
+		if isDefaultRoute(r) && !isAllowedExit(r.NetID, allowed) {
+			log.Infof("dropping exit route %s (%s): only %q is allowed by %s", r.NetID, r.Network, allowed, EnvAllowedExit)
+			continue
+		}
+		kept = append(kept, r)
+	}
+	return kept
+}
+
+// allowedPeerFromEnv returns the pinned peer overlay address and whether
+// pinning is on. An invalid address is returned as the zero Addr, which
+// matches no peer.
+func allowedPeerFromEnv() (netip.Addr, bool) {
+	val := strings.TrimSpace(os.Getenv(EnvAllowedPeerIP))
+	if val == "" {
+		return netip.Addr{}, false
+	}
+	if i := strings.IndexByte(val, '/'); i >= 0 {
+		val = val[:i]
+	}
+	addr, err := netip.ParseAddr(val)
+	if err != nil {
+		log.Warnf("failed to parse %s: %v", EnvAllowedPeerIP, err)
+		return netip.Addr{}, true
+	}
+	return addr.Unmap(), true
+}
+
+// peerHasOverlayAddr reports whether one of the peer's allowed IPs is exactly
+// addr as a single-host prefix.
+func peerHasOverlayAddr(p *mgmProto.RemotePeerConfig, addr netip.Addr) bool {
+	if !addr.IsValid() {
+		return false
+	}
+	for _, s := range p.GetAllowedIps() {
+		prefix, err := netip.ParsePrefix(s)
+		if err != nil {
+			continue
+		}
+		if prefix.Addr().Unmap() == addr && prefix.Bits() == prefix.Addr().BitLen() {
+			return true
+		}
+	}
+	return false
+}
+
+// findPinnedPeer returns the WireGuard key of the only remote peer with the
+// pinned overlay address, or "" when there is none or more than one.
+func findPinnedPeer(peers []*mgmProto.RemotePeerConfig, addr netip.Addr) string {
+	key := ""
+	for _, p := range peers {
+		if !peerHasOverlayAddr(p, addr) {
+			continue
+		}
+		if key != "" && key != p.GetWgPubKey() {
+			log.Warnf("more than one peer has the pinned address %s, refusing all", addr)
+			return ""
+		}
+		key = p.GetWgPubKey()
+	}
+	return key
+}
+
+// pinNetworkMapToPeer returns a copy of the network map that keeps only the
+// pinned peer (online or offline) and only routes whose routing peer is that
+// peer, both prefix and domain routes. Without the pinned peer the copy has no
+// remote peers and no routes. DNS settings are kept, so a nameserver on the
+// pinned peer keeps working.
+func pinNetworkMapToPeer(nm *mgmProto.NetworkMap, addr netip.Addr) *mgmProto.NetworkMap {
+	pinned := proto.Clone(nm).(*mgmProto.NetworkMap)
+
+	key := findPinnedPeer(nm.GetRemotePeers(), addr)
+	offlineKey := ""
+	if key == "" {
+		offlineKey = findPinnedPeer(nm.GetOfflinePeers(), addr)
+	}
+	pinned.RemotePeers = keepPeer(pinned.GetRemotePeers(), key)
+	pinned.OfflinePeers = keepPeer(pinned.GetOfflinePeers(), offlineKey)
+
+	routeKey := key
+	if routeKey == "" {
+		routeKey = offlineKey
+	}
+	routes := make([]*mgmProto.Route, 0, len(pinned.GetRoutes()))
+	for _, r := range pinned.GetRoutes() {
+		if routeKey != "" && r.GetPeer() == routeKey {
+			routes = append(routes, r)
+			continue
+		}
+		log.Infof("dropping route %s (%s%v): routing peer is not the pinned peer", r.GetNetID(), r.GetNetwork(), r.GetDomains())
+	}
+	pinned.Routes = routes
+
+	if key == "" && offlineKey == "" {
+		log.Warnf("pinned peer %s is not in the network map: no remote peers and no routes", addr)
+	}
+	return pinned
+}
+
+func keepPeer(peers []*mgmProto.RemotePeerConfig, key string) []*mgmProto.RemotePeerConfig {
+	kept := make([]*mgmProto.RemotePeerConfig, 0, 1)
+	if key == "" {
+		return kept
+	}
+	for _, p := range peers {
+		if p.GetWgPubKey() == key {
+			kept = append(kept, p)
+		}
+	}
+	return kept
+}
