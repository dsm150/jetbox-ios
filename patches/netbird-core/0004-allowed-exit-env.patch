+func TestPinNetworkMapToPeer(t *testing.T) {
+	nm, box, evil := pinnedTestNetworkMap(t)
+	addr := netip.MustParseAddr("100.79.115.162")
+
+	nm.DNSConfig = &mgmtProto.DNSConfig{ServiceEnable: true, NameServerGroups: []*mgmtProto.NameServerGroup{{
+		NameServers: []*mgmtProto.NameServer{{IP: "100.79.115.162", NSType: 1, Port: 53}}, Primary: true,
+	}}}
+	pinned := pinNetworkMapToPeer(nm, addr)
+	require.Len(t, pinned.GetDNSConfig().GetNameServerGroups(), 1, "the box nameserver group passes")
+	assert.Equal(t, "100.79.115.162", pinned.GetDNSConfig().GetNameServerGroups()[0].GetNameServers()[0].GetIP())
+	require.Len(t, pinned.GetRemotePeers(), 1)
+	assert.Equal(t, box, pinned.GetRemotePeers()[0].GetWgPubKey())
+	for _, r := range pinned.GetRoutes() {
+		assert.Equal(t, box, r.GetPeer(), "route %s must be routed by the box", r.GetNetID())
+	}
+	assert.Len(t, pinned.GetRoutes(), 3)
+	assert.Len(t, nm.GetRemotePeers(), 2, "the original map is not modified")
+
+	// A peer whose allowed IP is a wider prefix containing the box address is not the box.
+	wide := &mgmtProto.NetworkMap{RemotePeers: []*mgmtProto.RemotePeerConfig{
+		{WgPubKey: evil, AllowedIps: []string{"100.79.0.0/16"}},
+	}}
+	assert.Empty(t, pinNetworkMapToPeer(wide, addr).GetRemotePeers(), "only an exact /32 matches")
+
+	// Two peers claiming the same address: refuse both.
+	dup := &mgmtProto.NetworkMap{RemotePeers: []*mgmtProto.RemotePeerConfig{
+		{WgPubKey: box, AllowedIps: []string{"100.79.115.162/32"}},
+		{WgPubKey: evil, AllowedIps: []string{"100.79.115.162/32"}},
+	}}
+	assert.Empty(t, pinNetworkMapToPeer(dup, addr).GetRemotePeers(), "ambiguous address: no peer")
+
+	// Offline box: kept in the offline list, its routes still pass.
+	off := &mgmtProto.NetworkMap{
+		OfflinePeers: []*mgmtProto.RemotePeerConfig{{WgPubKey: box, AllowedIps: []string{"100.79.115.162/32", "fd00::5/128"}}},
+		Routes:       []*mgmtProto.Route{{ID: "lan", Network: "192.168.60.0/24", NetID: "lan", Peer: box}},
+	}
+	pinnedOff := pinNetworkMapToPeer(off, addr)
+	assert.Len(t, pinnedOff.GetOfflinePeers(), 1)
+	assert.Len(t, pinnedOff.GetRoutes(), 1)
+}
